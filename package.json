{
  "name": "ygor-luan-academy",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "agent:check": "node scripts/check-agent-context-sync.js",
    "agent:sync": "node scripts/check-agent-context-sync.js --write",
    "prepare": "simple-git-hooks",
    "quality-gate:init": "pnpm test:unit --coverage && node scripts/quality-gate.js init",
    "quality-gate:check": "node scripts/quality-gate.js check",
    "quality-gate:update": "pnpm test:unit --coverage && node scripts/quality-gate.js update",
    "pr-check": "pnpm type-check && pnpm lint && pnpm audit --audit-level=critical && pnpm test:unit && pnpm test:integration && node scripts/quality-gate.js check && pnpm build"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-branch.js && node scripts/check-test-only.js && pnpm type-check && pnpm agent:check && pnpm vitest run tests/unit --changed HEAD --passWithNoTests",
    "pre-push": "pnpm type-check && pnpm lint && pnpm test:unit && pnpm agent:check"
  },
  "dependencies": {
    "@astrojs/node": "10.1.1",
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "10.0.7",
    "@sentry/astro": "10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vimeo/player": "^2.30.3",
    "astro": "6.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^4.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.3.1",
    "jsdom": "^29.1.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
